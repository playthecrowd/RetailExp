# Snap Camera Kit (Phase 5B evaluation — see docs/RETAILEXP_PHASE_TRACKER.md)
#
# Copy this file to .env.local (already git-ignored — never commit real
# values) and fill in the three values from the Snap Kit Portal
# (kit.snapchat.com/manage). Leave any of them blank and the isolated
# /experience/kameleon/ar-snap-test route shows "Snap Camera Kit
# configuration pending." instead of attempting to start a session.
NEXT_PUBLIC_SNAP_CAMERA_KIT_API_TOKEN=
NEXT_PUBLIC_SNAP_LENS_ID=
NEXT_PUBLIC_SNAP_LENS_GROUP_ID=

# Supabase (Phase 7 — see docs/PHASE7_PLATFORM_ARCHITECTURE_PREFLIGHT.md)
#
# From your Supabase project's Settings -> API page. The first two are
# safe for the browser (anon key is subject to RLS, same as any other
# authenticated/anonymous request). SUPABASE_SERVICE_ROLE_KEY bypasses RLS
# entirely — it must never be prefixed with NEXT_PUBLIC_, never imported
# from a "use client" file, and never logged/committed. See
# lib/supabase/service-role.ts for the server-only guard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
